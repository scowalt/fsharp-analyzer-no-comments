<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <PackageId>Scowalt.NoCommentsAnalyzer</PackageId>
    <Version>0.1.1</Version>
    <SuppressDependenciesWhenPacking>true</SuppressDependenciesWhenPacking>
    <Authors>Scott Walters</Authors>
    <Description>FSharp.Analyzers.SDK analyzer that reports every comment token (//, ///, (* *)) except machine-read directives, generated files, and shebangs, with configurable directive prefixes and exemption globs.</Description>
    <PackageTags>fsharp;analyzers;lint;comments</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/scowalt/fsharp-analyzer-no-comments</PackageProjectUrl>
    <RepositoryUrl>https://github.com/scowalt/fsharp-analyzer-no-comments</RepositoryUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <NoWarn>$(NoWarn);NU5128</NoWarn>
    <DevelopmentDependency>true</DevelopmentDependency>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Glob.fs" />
    <Compile Include="Config.fs" />
    <Compile Include="Detection.fs" />
    <Compile Include="NoCommentsAnalyzer.fs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="FSharp.Analyzers.SDK" Version="0.39.2" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <None Include="$(OutputPath)$(AssemblyName).dll" Pack="true" PackagePath="analyzers/dotnet/fs" Visible="false" />
    <None Include="..\..\README.md" Pack="true" PackagePath="\" Visible="false" />
  </ItemGroup>

</Project>
